# The fetched ZIM snapshot, downloaded by `make fetch-zim`.
/.data/

# Dev-only SSH keypair for the simulated player VMs, generated by
# `make deploy-keys`. Never committed — regenerated per checkout.
/deploy/keys/

# Dev-only TLS distribution CA and per-role certs, generated by
# `make dist-certs`. Never committed — regenerated per checkout.
/deploy/certs/

# Competition-day settings and the finalists' checkouts on the platform VM
# (see deploy/final/). Never committed.
/deploy/final/final.env
/deploy/final/finalists/
