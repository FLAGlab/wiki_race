# Copy to final.env (never committed) and fill in. Every script in
# deploy/final/ reads it, on all four VMs, so copy the same file to each.

# Private IPs of the four VMs, as the other VMs reach them.
WIKI_IP=
PLATFORM_IP=
PLAYER1_IP=
PLAYER2_IP=

# HTTP port of the platform: the admin page and the dashboard. Pick a port
# the university network lets through from the classroom to the platform VM.
PLATFORM_PORT=8080

# The snapshot Kiwix serves. Competition day uses the full one.
KIWIX_BOOK=wikipedia_en_all_nopic

# The groups are in groups.txt, next to this file (see groups.txt.example).
# Each match starts its first group on PLAYER1_IP and its second group on
# PLAYER2_IP.

# Cookie of the platform node. Players never see it: each match starts
# every crawler with a cookie of its own.
PLATFORM_COOKIE=change-me
