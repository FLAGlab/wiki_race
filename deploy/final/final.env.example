# Copy to final.env (never committed) and fill in. Every script in
# deploy/final/ reads it, on all four VMs, so copy the same file to each.

# Private IPs of the four VMs, as the other VMs reach them.
WIKI_IP=
PLATFORM_IP=
PLAYER1_IP=
PLAYER2_IP=

# HTTP port of the platform: the admin page and the dashboard. Pick a port
# the university network lets through from the classroom to the platform VM.
PLATFORM_PORT=8080

# The snapshot Kiwix serves. Competition day uses the full one.
KIWIX_BOOK=wikipedia_en_all_nopic

# The two finalists. NAME is what the dashboard and standings show. REPO and
# TAG are the GitHub release to race. `wikirace fetch` clones them into
# deploy/final/finalists/1 and /2. APP is the `app:` of their mix.exs.
# Finalist 1 runs on PLAYER1_IP, finalist 2 on PLAYER2_IP.
FINALIST1_NAME="Group A"
FINALIST1_REPO=https://github.com/OWNER/REPO.git
FINALIST1_TAG=v1.0.0
FINALIST1_APP=player

FINALIST2_NAME="Group B"
FINALIST2_REPO=https://github.com/OWNER/REPO.git
FINALIST2_TAG=v1.0.0
FINALIST2_APP=player

# Cookie between the platform and the short-lived nodes that run the
# deploy commands. Players never see it: each deploy makes its own.
PLATFORM_COOKIE=change-me
