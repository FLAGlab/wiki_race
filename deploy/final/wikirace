#!/usr/bin/env bash
# Runs the platform and the deploy commands on the platform VM, with the
# settings of final.env and the groups of groups.txt. Run it as your normal
# user, never with sudo.
#
#   wikirace server          the platform on PLATFORM_PORT, in the foreground (run it in tmux)
#   wikirace fetch           clones every group of groups.txt at its tag
#   wikirace check           checks Kiwix, the groups, and SSH to both player VMs
#   wikirace deploy [GROUP]  builds every release (or one) and copies it to both player VMs
#   wikirace stop            stops every crawler on both player VMs
#
# Each match started on /admin starts its two crawlers on the player VMs.
# deploy and stop do not need `wikirace server` to be running.

set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ "$(id -u)" -ne 0 ] || die "run wikirace as your normal user, not with sudo"
load_env WIKI_IP PLATFORM_IP PLAYER1_IP PLAYER2_IP KIWIX_BOOK PLATFORM_COOKIE

export WIKI_RACE_GROUPS_FILE="$FINAL_DIR/groups.txt"
[ -f "$WIKI_RACE_GROUPS_FILE" ] ||
  die "$WIKI_RACE_GROUPS_FILE not found. Copy groups.txt.example to groups.txt and list the groups."

export PATH="$ELIXIR_DIR/bin:$OTP_DIR/bin:$PATH"
export WIKI_RACE_VMS=true
export KIWIX_BASE_URL=http://kiwix1:8080
export KIWIX_BOOK
export PORT="${PLATFORM_PORT:-4000}"
PLATFORM_NODE="platform@$PLATFORM_IP"

cd "$REPO_ROOT/platform"

cmd="${1:-}"
shift || true

case "$cmd" in
  server)
    epmd -names 2>/dev/null | grep -q "^name platform " && die "the platform is already running"
    exec elixir --name "$PLATFORM_NODE" --cookie "$PLATFORM_COOKIE" -S mix phx.server
    ;;

  fetch)
    mix wiki_race.fetch
    ;;

  check)
    step "Kiwix"
    curl -fsS -o /dev/null -L "$KIWIX_BASE_URL/content/$KIWIX_BOOK/Tiger" && echo "ok: $KIWIX_BASE_URL"
    step "Groups, article pairs and player VMs"
    mix run --no-start -e '
      alias WikiRacePlatform.Deploy.{Manifest, Match, Transport}
      {:ok, _} = Application.ensure_all_started([:ssh, :req])
      IO.puts("groups: " <> Enum.map_join(Manifest.groups(), ", ", & &1.name))
      IO.inspect(Manifest.check_groups(), label: "check_groups")
      IO.inspect(WikiRacePlatform.Articles.check_pairs(), label: "check_pairs")
      config = Application.get_env(:wiki_race_platform, :deploy)
      opts = [user: config[:ssh_user], user_dir: Path.expand(config[:ssh_user_dir])]
      for host <- Match.player_hosts() do
        IO.puts("\nplayer VM #{host}")
        with {:ok, conn} <- Transport.SSH.connect(host, opts) do
          cmd = "id -un; echo releases: $(ls /home/deploy/releases); " <>
            "curl -s -o /dev/null -w \"kiwix from player: HTTP %{http_code}\\n\" -L http://kiwix1:8080/; " <>
            "curl -s -m 5 -o /dev/null -w \"internet from player: HTTP %{http_code}\\n\" https://en.wikipedia.org/ || echo \"internet from player: blocked\""
          {:ok, out, _} = Transport.SSH.exec(conn, cmd)
          IO.write(out)
          Transport.SSH.close(conn)
        else
          error -> IO.puts("SSH failed: #{inspect(error)}")
        end
      end'
    ;;

  deploy)
    if [ $# -eq 0 ]; then
      START_HARNESS=false mix wiki_race.deploy --all
    else
      START_HARNESS=false mix wiki_race.deploy "$1"
    fi
    ;;

  stop)
    START_HARNESS=false mix wiki_race.stop --all
    ;;

  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
