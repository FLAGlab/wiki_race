<div class="fixed right-6 bottom-6 z-50 flex flex-col items-end gap-2">
  <p
    :if={@error}
    class="max-w-xs border-[3px] border-comic-red bg-comic-paper-light px-3 py-2 font-comic-mono text-xs font-bold text-comic-red shadow-comic-pop"
  >
    {@error}
  </p>

  <button
    :if={@next_fixture}
    type="button"
    phx-click="start_next"
    disabled={@starting}
    title={fixture_summary(@next_fixture)}
    class="flex items-center gap-2 rounded-full border-[3px] border-black bg-comic-yellow
           px-5 py-3 font-heading text-lg font-extrabold text-black shadow-comic-pop
           transition-transform hover:shadow-comic disabled:cursor-wait disabled:opacity-60"
  >
    {if @starting, do: "Starting…", else: "⏭ Next"}
  </button>
</div>
