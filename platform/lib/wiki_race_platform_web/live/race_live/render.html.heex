<Layouts.app flash={@flash} active_page={:race}>
  <.race_header
    :if={@snapshot.status != :idle}
    snapshot={@snapshot}
    elapsed={@elapsed}
    progress={@progress}
  />

  <div :if={@snapshot.status != :idle} class="mt-8">
    <.head_to_head :if={length(@snapshot.players) == 2}>
      <:a>
        <.spectator_player_panel
          player={Enum.at(@snapshot.players, 0)}
          result={@snapshot.result}
          winner?={winner?(@snapshot, Enum.at(@snapshot.players, 0))}
          accent={:red}
          bordered={false}
        />
      </:a>
      <:b>
        <.spectator_player_panel
          player={Enum.at(@snapshot.players, 1)}
          result={@snapshot.result}
          winner?={winner?(@snapshot, Enum.at(@snapshot.players, 1))}
          accent={:blue}
          bordered={false}
        />
      </:b>
    </.head_to_head>

    <.spectator_player_panel
      :for={player <- @snapshot.players}
      :if={length(@snapshot.players) != 2}
      player={player}
      result={@snapshot.result}
      winner?={winner?(@snapshot, player)}
      accent={:red}
    />
  </div>

  <.no_live_match :if={@snapshot.status == :idle} progress={@progress} />

  <.next_match_control
    :if={@snapshot.status != :running}
    next_fixture={@next_fixture}
    error={@error}
    starting={@starting}
  />
</Layouts.app>
