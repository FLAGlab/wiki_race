<Layouts.app flash={@flash} active_page={:admin}>
  <.header stamp="yellow">
    Race control
    <%!-- <:subtitle>Teacher-only &middot; admin panel</:subtitle>
    <:note>
      Deploying a group's release happens in the terminal
      (<code>mix wiki_race.deploy</code>). A node just needs to already be
      connected under the name in <code>priv/groups.exs</code>.
    </:note> --%>
  </.header>

  <.live_match :if={@snapshot.status == :running} snapshot={@snapshot} />

  <.next_match
    :if={@snapshot.status != :running}
    pairs={@pairs}
    pair={@pair}
    pair_overridden={@pair_overridden}
    progress={@progress}
    next_fixture={@next_fixture}
    history={@history}
    starting={@starting}
  />

  <.danger_zone :if={@snapshot.status != :running} />

  <p
    :if={@error}
    class="mt-4 border-[3px] border-comic-red bg-comic-red/10 px-4 py-3 font-comic-mono text-sm font-bold text-comic-red"
  >
    {@error}
  </p>
</Layouts.app>
