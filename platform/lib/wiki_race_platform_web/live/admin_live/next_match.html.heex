<div class="mx-auto max-w-lg">
  <p :if={@next_fixture} class="text-center font-display text-2xl tracking-wide">
    {fixture_summary(@next_fixture)}
  </p>
  <p :if={@next_fixture == nil} class="text-center text-comic-ink/60">
    No match currently queued. The tournament may be finished, or nothing
    has been raced yet.
  </p>

  <div class="mt-6 border-[3px] border-black bg-comic-paper-light p-4">
    <label
      for="pair-select"
      class="mb-1 block font-comic-mono text-[10px] font-bold tracking-wider text-comic-ink/60 uppercase"
    >
      {round_pair_label(@progress, @pair_overridden)}
    </label>
    <form id="pair-form" phx-change="set_pair">
      <select
        id="pair-select"
        name="pair"
        class="w-full border-[3px] border-black bg-comic-paper-light px-3 py-2 font-heading font-semibold text-comic-ink"
      >
        <option
          :for={{option, index} <- Enum.with_index(@pairs)}
          value={index}
          selected={@pair == option}
        >
          {option.start} &rarr; {option.target}{note_suffix(option)}
        </option>
      </select>
    </form>
  </div>

  <button
    type="button"
    phx-click="start_next"
    disabled={@next_fixture == nil or @starting}
    class="mt-4 w-full border-[3px] border-black bg-comic-yellow px-6 py-3 font-heading
           font-extrabold tracking-wide text-black shadow-comic-pop transition-transform
           disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none"
  >
    {start_label(@starting, @history)}
  </button>
</div>
